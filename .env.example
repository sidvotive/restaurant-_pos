# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# ---------- PostgreSQL ----------
POSTGRES_USER=rpos
POSTGRES_PASSWORD=rpos_dev_password
POSTGRES_DB=rpos
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- RabbitMQ ----------
RABBITMQ_USER=rpos
RABBITMQ_PASSWORD=rpos_dev_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---------- MinIO (S3-compatible object storage) ----------
MINIO_ROOT_USER=rpos
MINIO_ROOT_PASSWORD=rpos_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Backend (example; per-service config lands with each service) ----------
# ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=rpos;Username=rpos;Password=rpos_dev_password
# ConnectionStrings__Redis=localhost:6379
# Jwt__Issuer=restaurant-pos
# Jwt__Audience=restaurant-pos-clients
# Jwt__Secret=CHANGE_ME_use_a_long_random_value
