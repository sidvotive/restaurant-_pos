# Copy to .env.local for local overrides (git-ignored).

# API base URL for the frontend. Leave empty to use the Vite dev proxy
# (recommended in dev: /api → VITE_API_PROXY). Set to a full URL (e.g.
# http://localhost:5080) to call the API directly (requires backend CORS).
VITE_API_BASE=

# Dev-only: where the Vite dev server forwards /api requests.
VITE_API_PROXY=http://localhost:5080

# Set to "true" to use the built-in mock auth (no backend required).
# Demo login is then owner@demo.test / password123.
VITE_USE_MOCK_AUTH=
